#the mod name as displayed in-game
displayName: "组合工厂"

#the internal name of your mod
name: "combine"

#your name
author: "R"

#the fully qualified main class of the mod
main: "combine.Main"

#the mod description as seen in the mod dialog
description: "1.2 组合普通工厂/地形加成工厂/分离机/普通钻头/挖墙钻头（含震地钻头），支持跨模组覆盖（关闭模组后原版建筑需重新解锁）\n1.3 组合发电机\n1.4 组合力墙、修复投影、超速投影、发射台\n1.5 组合仓库\n1.6 组合泵、接收台、挖墙钻\n1.7 组合逻辑处理器，蓝图里的建筑也会被替换为组合建筑\n1.8 组合炮台、组合抽水机、组合墙\n1.9 支持过剧情\n2.0 核心机多线程建造\n2.1 组合单位工厂、组合单位升级厂\n2.2 每种物品、每种液体各自独立储存（不再共用一份总量）；发电机燃料消耗与原版一致、不再一次吞掉多个燃料；组合仓库连通核心时给核心扩容；物品外送改为每 tick 一次（塞得满传送带/管道）；联机时建造菜单里的组合建筑不再消失\n2.3 新增协作组合：继承原版类、自己写了新功能的方块（js 与 java 子类）也能组合 —— 物品/液体/容量/电力/热量共享，支持跨类型组合，中间产物留在组内，点击方块可在其正上方查看整组内容；组合连接器/节点放置不再卡顿；建造武器按 E 可停掉全部线程、并优先去帮正在施工的建筑；放置组合节点时给可连接的组合体加蓝框；js 写的带相位护盾参数的力墙子类也纳入组合；组合节点/组合连接器同样能组合 js/java 子类建筑（含节点激光跨距离连接），连起来的协作方块和原版组合方块共用一份库存、信息面板互相显示；update=false 的存储类子类（mod 仓库、容器）也能组合；连接器、节点接起来的组合体容量与信息面板都按整张网络算（组合仓库同样），反复存读档容量不再翻倍"

#the mod version
version: 2.3

#the minimum game build required to run this mod
minGameVersion: 159

#this is a java mod
java: true
//hidden:true
